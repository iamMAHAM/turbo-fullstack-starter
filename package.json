{
	"name": "turbo-fullstack-starter",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"engines": {
		"node": ">=24"
	},
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check": "biome check .",
		"check:fix": "biome check . --write",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"test:e2e": "turbo run test:e2e",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"lefthook": "^2.2.2",
		"turbo": "^2.11.10",
		"typescript": "6.0.3"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"@prisma/engines",
		"@swc/core",
		"esbuild",
		"lefthook",
		"prisma",
		"turbo"
	],
	"overrides": {
		"multer": "^2.5.0"
	}
}
