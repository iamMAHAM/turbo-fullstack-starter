{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": ["NEXT_PUBLIC_*"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"check-types": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"test:e2e": {
			"dependsOn": ["^build"],
			"cache": false,
			"passThroughEnv": [
				"NODE_ENV",
				"PORT",
				"LOG_LEVEL",
				"DATABASE_URL",
				"BETTER_AUTH_*",
				"AUTH_COOKIE_SAME_SITE",
				"CORS_ORIGINS",
				"API_PREFIX",
				"TRUST_PROXY",
				"THROTTLE_*"
			]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		}
	}
}
